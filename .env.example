# منفذ الخادم (اختياري، الافتراضي 3000)
PORT=3000

# اتصال قاعدة بيانات MySQL (يفضّل تفعيل TLS في الاستضافة)
# مثال مع TLS (موصى به لـ TiDB Cloud وVercel):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/dbname
# مثال محلي بدون TLS:
# DATABASE_URL=mysql://user:pass@host:3306/dbname?ssl-mode=disabled
DATABASE_URL=mysql://user:pass@host:3306/dbname?ssl-mode=disabled

# حد الاتصالات لكل دالة (اختياري). الافتراضي 1 على Vercel و5 محليًا
# DB_CONNECTION_LIMIT=1

# حساب Cloudinary المجاني (من لوحة التحكم بعد إنشاء الحساب)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_API_SECRET_HERE

# كلمة مرور لوحة الإدارة على المسار /admin (لا توجد قيمة افتراضية)
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# مفتاح توقيع جلسة الإدارة — استخدم نصًا طويلًا وعشوائيًا
SESSION_SECRET=YOUR_SESSION_SECRET_HERE
