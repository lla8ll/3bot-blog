# منفذ الخادم (اختياري، الافتراضي 3000)
PORT=3000

# اتصال قاعدة بيانات MySQL. استخدم DATABASE_URL أو المتغيرات المنفصلة (وليس الاثنين معًا إلا إذا أردت أن يُفض’ل DATABASE_URL).
# يُفض’ل تفعيل TLS في الاستضافة. نقطة TiDB Cloud العامة تستخدم شهادات Let's Encrypt الموثوقة في مخزن النظام،
# والخادم يفع’ل TLS مع rejectUnauthorized=true وminVersion=TLSv1.2 افتراضيًا.

# خيار 1: سلسلة اتصال واحدة (إن وُجدت تُستخدم أولًا)
# مثال مع TLS (موصى به لـ TiDB Cloud وVercel):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/dbname
# مثال محلي بدون TLS:
# DATABASE_URL=mysql://user:pass@host:3306/dbname?ssl-mode=disabled
# DATABASE_URL=mysql://user:pass@host:3306/dbname?ssl-mode=disabled

# خيار 2: متغيرات منفصلة (تُستخدم إذا لم يُضبط DATABASE_URL)
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=YOUR_DB_USER_HERE
# DB_PASSWORD=YOUR_DB_PASSWORD_HERE
# DB_NAME=test
# لتعطيل TLS محليًا عند استخدام المتغيرات المنفصلة:
# DB_SSL=disabled

# حد الاتصالات لكل دالة (اختياري). الافتراضي 1 على Vercel و5 محليًا
# DB_CONNECTION_LIMIT=1

# حساب Cloudinary المجاني (من لوحة التحكم بعد إنشاء الحساب)
# الصق القيم الحقيقية كما هي، دون علامات اقتباس. لـ API Secret انسخ السر الكامل
# من صفحة الإعدادات، وليس القيمة المقنّعة التي تظهر كنجوم (*).
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_API_SECRET_HERE

# كلمة مرور لوحة الإدارة على المسار /admin (لا توجد قيمة افتراضية)
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# مفتاح توقيع جلسة الإدارة — استخدم نصًا طويلًا وعشوائيًا
SESSION_SECRET=YOUR_SESSION_SECRET_HERE
